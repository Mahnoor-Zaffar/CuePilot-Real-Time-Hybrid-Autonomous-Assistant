# ─── LLM (OpenRouter, OpenAI-compatible) ─────────────────────────────────────
# Without a key the server transparently runs the deterministic mock provider.
CUEPILOT_OPENROUTER_API_KEY=
CUEPILOT_LLM_MODEL=openai/gpt-4o-mini
# JSON array, tried in order when the primary model is rate limited.
CUEPILOT_LLM_FALLBACK_MODELS=["openai/gpt-4o-mini","anthropic/claude-3.5-haiku"]
# auto | openrouter | mock
CUEPILOT_LLM_PROVIDER=auto

# ─── Embeddings ──────────────────────────────────────────────────────────────
# auto | openai | hash | local
#   auto   hosted embeddings when CUEPILOT_OPENAI_API_KEY is set, else hash
#   local  model2vec static sentence embeddings: semantic, offline, no key
#          (install with: cd server && uv sync --extra local)
# Without a key or the extra, the deterministic hash embedder keeps retrieval working.
CUEPILOT_OPENAI_API_KEY=
CUEPILOT_EMBEDDING_PROVIDER=auto
CUEPILOT_EMBEDDING_MODEL=text-embedding-3-small
# Requested width for the openai/hash paths. A local model declares its own width,
# which becomes the schema's VECTOR(n). Changing width rebuilds kb_chunks on boot.
CUEPILOT_EMBEDDING_DIM=1536
CUEPILOT_LOCAL_EMBEDDING_MODEL=minishlab/potion-base-8M

# ─── Infrastructure (docker compose maps these host ports) ───────────────────
CUEPILOT_DATABASE_URL=postgresql://cuepilot:cuepilot@127.0.0.1:5433/cuepilot
CUEPILOT_REDIS_URL=redis://127.0.0.1:6380/0
# If Postgres/Redis are unreachable, fall back to in-process stores.
CUEPILOT_ALLOW_DEGRADED_INFRA=true

# ─── Streaming / retrieval tuning ────────────────────────────────────────────
CUEPILOT_RETRIEVAL_TOP_K=8
CUEPILOT_RETRIEVAL_CANDIDATE_K=50
CUEPILOT_RETRIEVAL_MAX_CHUNKS_PER_DOC=1
CUEPILOT_RRF_K=60
CUEPILOT_DELTA_FLUSH_MS=16
CUEPILOT_WS_SEND_QUEUE_SIZE=64
CUEPILOT_WS_HEARTBEAT_INTERVAL_S=20

# ─── Telemetry ───────────────────────────────────────────────────────────────
CUEPILOT_OTEL_ENABLED=true
# none | console | otlp
# none: keep recording spans in-process (queryable via /api/traces/{id}) without
# exporting them. Set console for a readable local dump, otlp for a collector.
CUEPILOT_OTEL_EXPORTER=none
CUEPILOT_OTEL_ENDPOINT=http://127.0.0.1:4318

# ─── Optional API auth (Bearer token for REST, ?token= for WS) ───────────────
CUEPILOT_API_TOKEN=
