# ─── LLM (OpenRouter, OpenAI-compatible) ─────────────────────────────────────
# Without a key the server transparently runs the deterministic mock provider.
CUEPILOT_OPENROUTER_API_KEY=
CUEPILOT_LLM_MODEL=openai/gpt-4o-mini
# JSON array, tried in order when the primary model is rate limited.
CUEPILOT_LLM_FALLBACK_MODELS=["openai/gpt-4o-mini","anthropic/claude-3.5-haiku"]
# auto | openrouter | mock
CUEPILOT_LLM_PROVIDER=auto

# ─── Embeddings ──────────────────────────────────────────────────────────────
# auto | openai | hash | local
#   auto   hosted embeddings when CUEPILOT_OPENAI_API_KEY is set, else hash
#   local  model2vec static sentence embeddings: semantic, offline, no key
#          (install with: cd server && uv sync --extra local)
# Without a key or the extra, the deterministic hash embedder keeps retrieval working.
CUEPILOT_OPENAI_API_KEY=
CUEPILOT_EMBEDDING_PROVIDER=auto
CUEPILOT_EMBEDDING_MODEL=text-embedding-3-small
# Requested width for the openai/hash paths. A local model declares its own width,
# which becomes the schema's VECTOR(n). Changing width rebuilds kb_chunks on boot.
CUEPILOT_EMBEDDING_DIM=1536
CUEPILOT_LOCAL_EMBEDDING_MODEL=minishlab/potion-base-8M

# ─── Infrastructure (docker compose maps these host ports) ───────────────────
CUEPILOT_DATABASE_URL=postgresql://cuepilot:cuepilot@127.0.0.1:5433/cuepilot
CUEPILOT_REDIS_URL=redis://127.0.0.1:6380/0
# If Postgres/Redis are unreachable, fall back to in-process stores.
CUEPILOT_ALLOW_DEGRADED_INFRA=true

# ─── Durable sessions ────────────────────────────────────────────────────────
# Redis mirrors a session; Postgres is the record. Writes are queued so a slow
# database costs transcript lines, never stream latency. Requires Postgres.
CUEPILOT_SESSION_JOURNAL_ENABLED=true
# Bounded write-behind queue. Checkpoints drop when full; terminal turns spool.
CUEPILOT_SESSION_JOURNAL_QUEUE=256
CUEPILOT_SESSION_JOURNAL_TIMEOUT_S=5.0
# Graceful-shutdown drain budget for the journal worker.
CUEPILOT_SESSION_JOURNAL_DRAIN_S=3.0
# Streaming checkpoint cadence: a hard crash loses at most this much text.
CUEPILOT_TURN_CHECKPOINT_INTERVAL_MS=250
# A streaming row older than this is marked interrupted when the session is read.
CUEPILOT_TURN_CHECKPOINT_STALE_S=60.0
# Terminal writes spill here when the queue or Postgres is unavailable, then replay.
# Empty string disables the local spool (the write is then tried on the shared cache).
CUEPILOT_SESSION_JOURNAL_SPOOL_PATH=data/journal-spool.ndjson
CUEPILOT_SESSION_JOURNAL_SPOOL_MAX_BYTES=8000000
# How long a terminal turn stays in the shared-cache spool when local disk is
# unavailable or full. Redis persistence is the operator's responsibility.
CUEPILOT_SESSION_JOURNAL_SPOOL_CACHE_TTL_S=3600
CUEPILOT_SESSION_JOURNAL_SPOOL_RETRY_S=30.0

# ─── Client limits ───────────────────────────────────────────────────────────
# Sliding-window per-client connection limit, shared through the cache. The
# concurrent cap is per replica because ws_active is a process gauge.
CUEPILOT_RATE_LIMIT_ENABLED=true
CUEPILOT_RATE_LIMIT_WINDOW_S=60
CUEPILOT_RATE_LIMIT_CONNECT_ATTEMPTS=30
CUEPILOT_RATE_LIMIT_MAX_CONNECTIONS=200
# Only enable behind a trusted proxy: an untrusted X-Forwarded-For is spoofable.
CUEPILOT_RATE_LIMIT_TRUST_FORWARDED_FOR=false
# Trusted header carrying client identity (operator-controlled; unset = socket peer).
CUEPILOT_RATE_LIMIT_IDENTITY_HEADER=
# Per-session budgets over the same window. Turns are checked at admission;
# tokens are recorded after each completed turn (overshoot by at most one turn).
CUEPILOT_RATE_LIMIT_SESSION_TURNS=30
CUEPILOT_RATE_LIMIT_SESSION_TOKENS=120000

# ─── Streaming / retrieval tuning ────────────────────────────────────────────
CUEPILOT_RETRIEVAL_TOP_K=8
CUEPILOT_RETRIEVAL_CANDIDATE_K=50
CUEPILOT_RETRIEVAL_MAX_CHUNKS_PER_DOC=1
CUEPILOT_RRF_K=60
CUEPILOT_DELTA_FLUSH_MS=16
CUEPILOT_WS_SEND_QUEUE_SIZE=64
CUEPILOT_WS_HEARTBEAT_INTERVAL_S=20

# ─── Telemetry ───────────────────────────────────────────────────────────────
CUEPILOT_OTEL_ENABLED=true
# none | console | otlp
# none: keep recording spans in-process (queryable via /api/traces/{id}) without
# exporting them. Set console for a readable local dump, otlp for a collector.
CUEPILOT_OTEL_EXPORTER=none
CUEPILOT_OTEL_ENDPOINT=http://127.0.0.1:4318
# Each replica publishes a bucket snapshot; /api/metrics and /metrics merge
# live snapshots additively (every observation is counted).
CUEPILOT_METRICS_PUBLISH_INTERVAL_S=10.0
CUEPILOT_METRICS_PUBLISH_TTL_S=30

# ─── Optional API auth (Bearer token for REST, ?token= for WS) ───────────────
CUEPILOT_API_TOKEN=
