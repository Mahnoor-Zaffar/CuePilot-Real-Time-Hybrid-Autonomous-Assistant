# Desktop client configuration (Vite exposes only VITE_* to the renderer).
# Copy to .env.local; .env files are git-ignored.

# Gateway WebSocket endpoint. Defaults to ws://127.0.0.1:8000/ws/stream.
VITE_WS_URL=ws://127.0.0.1:8000/ws/stream

# Only needed when the server sets CUEPILOT_API_TOKEN. Sent as ?token=...
VITE_WS_TOKEN=
