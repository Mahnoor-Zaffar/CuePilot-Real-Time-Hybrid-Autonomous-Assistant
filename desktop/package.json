{
  "name": "cuepilot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "cuePilot desktop client (Electron + React)",
  "author": "Mahnoor Zaffar",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,yellow \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && vite build",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "check:audio": "node scripts/check-audio.cjs",
    "start": "electron .",
    "measure-idle": "electron scripts/measure-idle.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cuepilot.desktop",
    "productName": "cuePilot",
    "copyright": "Copyright © 2026 cuePilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "cuePilot streams microphone audio to your local gateway so the assistant can hear you.",
        "NSAudioCaptureUsageDescription": "cuePilot captures system audio so the assistant can hear the call or video you are watching."
      }
    },
    "dmg": {
      "title": "cuePilot ${version}"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@33.4.11": true
  }
}
